<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>EM Portal Record Details</masterLabel>
    <description>Onboarding Hub (LWR): record fields in their page-layout sections (Full layout via UI API), collapsible like Lightning, inline edit per FLS with Save / Cancel. Session 85, 2026-10-01.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Record Id" default="{!recordId}"/>
            <property name="objectApiName" type="String" label="Object API name" default=""/>
            <property name="hiddenFields" type="String" label="Fields to hide (comma-separated API names)" default=""/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>