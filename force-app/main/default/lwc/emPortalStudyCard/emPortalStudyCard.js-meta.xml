<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>EM Portal Study Card</masterLabel>
    <description>EM Study Portal (LWR) wrapper for c/emStudyCard on the Care Program Detail page - site-only targets so the LEX component stays LEX-pure. WU8 regression fix 2026-09-10 (mixed targets from WU7 broke LEX rendering).</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Record Id" default="{!recordId}"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>