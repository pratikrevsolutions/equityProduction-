<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>WU10-14b. Care Program Team Member after-save: rebuilds the study&apos;s five read-only people mirrors (PI, Sub-I, Lead CRC, Back-Up CRC, Blinded Raters) via EM_Study_Team_Mirror. Honours Migration Mode. Known edge case: if a row is moved to a different study, only the new study is rebuilt - the old one corrects itself on its next team-member change.</description>
    <environments>Default</environments>
    <interviewLabel>EM Study Team Mirror Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EM Study Team Mirror Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Rebuild_Mirrors</targetReference>
        </connector>
        <filterFormula>NOT({!$Setup.Migration_Mode__c.Is_Active__c}) &amp;&amp; NOT(ISBLANK({!$Record.CareProgramId}))</filterFormula>
        <object>CareProgramTeamMember</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Rebuild_Mirrors</name>
        <label>Rebuild the study&apos;s people mirrors</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <flowName>EM_Study_Team_Mirror</flowName>
        <inputAssignments>
            <name>var_CareProgramId</name>
            <value>
                <elementReference>$Record.CareProgramId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
