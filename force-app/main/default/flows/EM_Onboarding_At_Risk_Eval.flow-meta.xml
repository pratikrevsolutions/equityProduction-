    <description>F-09 core (Phase 4 WU3). Input: CareProgram Id. Evaluates the active EM_Onboarding_SLA__mdt rules - Days In Step (vs Step_Entered_Date__c, fallback Study Awarded Date), Item Overdue Grace (open required EM-keyed tasks on the study and its sites past due date + grace; earliest named, count appended), Target Activation Window (target within X days at progress below Y percent); Portal Untouched rows are ignored until Phase 5. Writes At_Risk__c / At_Risk_Reason__c (255-capped) only on change. Not Started / Site Activated / statusless studies only get stale flags cleared. Migration Mode = full no-op. Reason wording comes from the rows Reason_Text__c ({step} {days} {item} {pct} placeholders).</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Bypass</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Migration_Mode__c.Is_Active__c}</expression>
    </formulas>
    <formulas>
        <name>fx_Changed</name>
        <dataType>Boolean</dataType>
        <expression>{!fx_NewAtRisk} &lt;&gt; {!Get_CP.At_Risk__c} || {!fx_ReasonFinal} &lt;&gt; BLANKVALUE({!Get_CP.At_Risk_Reason__c}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_DaysInStep</name>
        <dataType>Number</dataType>
        <expression>{!$Flow.CurrentDate} - BLANKVALUE({!Get_CP.Step_Entered_Date__c}, BLANKVALUE({!Get_CP.Study_Awarded_Date__c}, {!$Flow.CurrentDate}))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fx_DaysToTarget</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_CP.EM_Projected_Activation_Date__c}, BLANKVALUE({!Get_CP.Target_Activation_Date__c}, {!$Flow.CurrentDate} + 3650)) - {!$Flow.CurrentDate}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fx_Evaluate</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!fx_Status}) &gt; 0 &amp;&amp; {!fx_Status} &lt;&gt; &quot;Not Started&quot; &amp;&amp; {!fx_Status} &lt;&gt; &quot;Site Activated&quot; &amp;&amp; {!fx_Override} &lt;&gt; &quot;On Hold&quot; &amp;&amp; {!fx_Override} &lt;&gt; &quot;Withdrawn / Cancelled&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_NewAtRisk</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!var_Reasons}) &gt; 0</expression>
    </formulas>
    <formulas>
        <name>fx_Override</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!Get_CP.EM_Status_Override__c}), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_ReasonDIS</name>
        <dataType>String</dataType>
        <expression>&quot;&quot; &amp; SUBSTITUTE(SUBSTITUTE(BLANKVALUE({!var_StepTemplate}, &quot;&quot;), &quot;{step}&quot;, {!fx_Status}), &quot;{days}&quot;, TEXT({!fx_DaysInStep}))</expression>
    </formulas>
    <formulas>
        <name>fx_ReasonFinal</name>
        <dataType>String</dataType>
        <expression>LEFT({!var_Reasons}, 255)</expression>
    </formulas>
    <formulas>
        <name>fx_ReasonsIOG</name>
        <dataType>String</dataType>
        <expression>&quot;&quot; &amp; {!var_Reasons} &amp; IF(LEN({!var_Reasons}) &gt; 0, &quot;; &quot;, &quot;&quot;) &amp; SUBSTITUTE(SUBSTITUTE(BLANKVALUE({!var_ItemTemplate}, &quot;&quot;), &quot;{item}&quot;, BLANKVALUE({!var_FirstSubject}, &quot;&quot;)), &quot;{days}&quot;, TEXT({!var_FirstDays})) &amp; IF({!var_OverdueCount} &gt; 1, &quot; (+&quot; &amp; TEXT({!var_OverdueCount} - 1) &amp; &quot; more)&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_ReasonsTAW</name>
        <dataType>String</dataType>
        <expression>&quot;&quot; &amp; {!var_Reasons} &amp; IF(LEN({!var_Reasons}) &gt; 0, &quot;; &quot;, &quot;&quot;) &amp; SUBSTITUTE(SUBSTITUTE(BLANKVALUE({!var_ActTemplate}, &quot;&quot;), &quot;{days}&quot;, TEXT({!fx_DaysToTarget})), &quot;{pct}&quot;, TEXT(BLANKVALUE({!Get_CP.Onboarding_Progress__c}, 0)))</expression>
    </formulas>
    <formulas>
        <name>fx_Status</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!Get_CP.Onboarding_Status__c}), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_TaskOverdue</name>
        <dataType>Number</dataType>
        <expression>{!$Flow.CurrentDate} - BLANKVALUE({!L_Tasks.ActivityDate}, {!$Flow.CurrentDate})</expression>
        <scale>0</scale>
    </formulas>
