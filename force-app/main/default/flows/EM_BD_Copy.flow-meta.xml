<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Done</name>
        <label>Report</label>
        <locationX>400</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>out_Copied</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>out_Message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_Message</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_NotLinked</name>
        <label>Not linked to a BD opportunity</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>out_Message</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>This study is not linked to a BD Opportunity (BD Opportunity field is empty) — nothing to copy.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decision_Linked</name>
        <label>Linked to a BD opportunity?</label>
        <locationX>250</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Assign_NotLinked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Decision_Linked_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_CP.BD_Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opp</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>WU10-15f (Abbey 2026-09-15 #5–#8: &quot;will SQV Date / Protocol Number / Therapeutic Area / Start Date copy from the BD Opportunity?&quot; — yes). F-07 step 3 built ahead of the D-7 trigger decision. Input: CareProgram Id (+ in_Overwrite, default false = fill blank study fields only). READS Grace&apos;s BD Opportunity (system mode, because study-ops users hold no access to her fields) and copies the overlap onto the study: Protocol Number, Therapeutic Area (Allergy/Immunology → Allergy, Hormonal Disorders → Metabolic/Endocrine, others 1:1), Phase (identical value sets), Indication → Disease (text; Condition stays a deliberate choice because its values are byte-for-byte legacy), Assigned PI → PI (text), SQV Date, Site Selection Letter Date → Selection Letter Received Date (the before-save stamp ticks the checkbox), Anticipated Study Activation Date → Start Date (EM_Start_Date__c), Cost per Patient → Original CPP + Current CPP, CRO, Sponsor. Never writes the Opportunity. Called by EM_Onboarding_Start and by the &quot;Refresh from BD&quot; quick action (EM_BD_Refresh).</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_CRO</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.CRO_if_applicable__c})), OR({!in_Overwrite}, ISBLANK({!Get_CP.CRO__c}))), {!Get_Opp.CRO_if_applicable__c}, {!Get_CP.CRO__c})</expression>
    </formulas>
    <formulas>
        <name>fx_CurCPP</name>
        <dataType>Currency</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.Cost_per_Patient__c})), OR({!in_Overwrite}, ISBLANK({!Get_CP.EM_Current_CPP__c}))), {!Get_Opp.Cost_per_Patient__c}, {!Get_CP.EM_Current_CPP__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fx_Disease</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK(TEXT({!Get_Opp.Indication__c}))), OR({!in_Overwrite}, ISBLANK({!Get_CP.EM_Disease__c}))), TEXT({!Get_Opp.Indication__c}), {!Get_CP.EM_Disease__c})</expression>
    </formulas>
    <formulas>
        <name>fx_Message</name>
        <dataType>String</dataType>
        <expression>&quot;Copied from BD opportunity &quot; &amp; {!Get_Opp.Name} &amp; &quot; (&quot; &amp; TEXT({!Get_Opp.StageName}) &amp; &quot;)&quot; &amp; IF({!in_Overwrite}, &quot; — existing values overwritten.&quot;, &quot; — only empty study fields were filled.&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_OrigCPP</name>
        <dataType>Currency</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.Cost_per_Patient__c})), OR({!in_Overwrite}, ISBLANK({!Get_CP.EM_Original_CPP__c}))), {!Get_Opp.Cost_per_Patient__c}, {!Get_CP.EM_Original_CPP__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fx_Phase</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK(TEXT({!Get_Opp.Phase__c}))), OR({!in_Overwrite}, ISBLANK(TEXT({!Get_CP.Phase__c})))), TEXT({!Get_Opp.Phase__c}), TEXT({!Get_CP.Phase__c}))</expression>
    </formulas>
    <formulas>
        <name>fx_PI</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK(TEXT({!Get_Opp.Assigned_PI__c}))), OR({!in_Overwrite}, ISBLANK({!Get_CP.EM_PI__c}))), TEXT({!Get_Opp.Assigned_PI__c}), {!Get_CP.EM_PI__c})</expression>
    </formulas>
    <formulas>
        <name>fx_Protocol</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.Protocol_Number__c})), OR({!in_Overwrite}, ISBLANK({!Get_CP.Protocol_Number__c}))), {!Get_Opp.Protocol_Number__c}, {!Get_CP.Protocol_Number__c})</expression>
    </formulas>
    <formulas>
        <name>fx_SelLetter</name>
        <dataType>Date</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.Site_Selection_Letter_Date__c})), OR({!in_Overwrite}, ISBLANK({!Get_CP.EM_Selection_Letter_Received_Date__c}))), {!Get_Opp.Site_Selection_Letter_Date__c}, {!Get_CP.EM_Selection_Letter_Received_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fx_Sponsor</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.AccountId})), OR({!in_Overwrite}, ISBLANK({!Get_CP.SponsorId}))), {!Get_Opp.AccountId}, {!Get_CP.SponsorId})</expression>
    </formulas>
    <formulas>
        <name>fx_SQV</name>
        <dataType>Date</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.SQV_Date__c})), OR({!in_Overwrite}, ISBLANK({!Get_CP.SQV_Date__c}))), {!Get_Opp.SQV_Date__c}, {!Get_CP.SQV_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fx_Start</name>
        <dataType>Date</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Opp.Study_Start_Date__c})), OR({!in_Overwrite}, ISBLANK({!Get_CP.EM_Start_Date__c}))), {!Get_Opp.Study_Start_Date__c}, {!Get_CP.EM_Start_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fx_TA</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!fx_TA_Src})), OR({!in_Overwrite}, ISBLANK(TEXT({!Get_CP.Therapeutic_Area__c})))), {!fx_TA_Src}, TEXT({!Get_CP.Therapeutic_Area__c}))</expression>
    </formulas>
    <formulas>
        <name>fx_TA_Src</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Get_Opp.Therapeutic_Area__c}), &quot;Allergy/Immunology&quot;, &quot;Allergy&quot;, &quot;Hormonal Disorders&quot;, &quot;Metabolic/Endocrine&quot;, TEXT({!Get_Opp.Therapeutic_Area__c}))</expression>
    </formulas>
    <interviewLabel>EM BD Copy {!$Flow.CurrentDateTime}</interviewLabel>
