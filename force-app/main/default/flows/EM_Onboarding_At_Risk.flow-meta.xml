<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>F-09 (Phase 4 WU3). Daily 08:00 UTC over every CareProgram with a Study Awarded Date: runs EM_Onboarding_At_Risk_Eval, which applies the active EM_Onboarding_SLA__mdt rules and maintains At_Risk__c / At_Risk_Reason__c (cleared once Not Started / Site Activated). SLA numbers are data - Abbey Q4 replaces the placeholder rows without touching this flow. Migration Mode honoured inside the subflow.</description>
    <environments>Default</environments>
    <interviewLabel>EM Onboarding At Risk {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EM Onboarding At Risk</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Call_Eval</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Study_Awarded_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>CareProgram</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-09-03</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_Eval</name>
        <label>Evaluate at-risk rules</label>
        <locationX>250</locationX>
        <locationY>120</locationY>
        <flowName>EM_Onboarding_At_Risk_Eval</flowName>
        <inputAssignments>
            <name>in_CareProgramId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
