<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_EvalSite</name>
        <label>At Risk already re-evaluated by Recalc?</label>
        <locationX>1250</locationX>
        <locationY>660</locationY>
        <defaultConnector>
            <targetReference>AtRisk_Site</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - evaluate now</defaultConnectorLabel>
        <rules>
            <name>Decision_EvalSite_Done</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recalc_Site.out_Changed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes (study was written)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_EvalStudy</name>
        <label>At Risk already re-evaluated by Recalc?</label>
        <locationX>0</locationX>
        <locationY>780</locationY>
        <defaultConnector>
            <targetReference>AtRisk_Study</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - evaluate now</defaultConnectorLabel>
        <rules>
            <name>Decision_EvalStudy_Done</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recalc_Study.out_Changed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes (study was written)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Reopened</name>
        <label>Re-opened from Completed?</label>
        <locationX>250</locationX>
        <locationY>120</locationY>
        <defaultConnector>
            <targetReference>Get_Site</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Decision_Reopened_Reopened</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_Reopened</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Exception</targetReference>
            </connector>
            <label>Yes — exception</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Site</name>
        <label>Site task?</label>
        <locationX>1000</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Recalc_Study</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Study task</defaultConnectorLabel>
        <rules>
            <name>Decision_Site_Site</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Site.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recalc_Site</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>F-08 trigger (a): an onboarding task (EM Item Key set) whose Status, due date or Required flag was changed by a person (date/required added 2026-10-08 so At Risk follows date edits at once). Skipped when EM Auto Completed changed in the same save (that is Recalc&apos;s own write) and in Migration Mode. A task re-opened from Completed is marked Source = Exception (auto-completion leaves it alone until a person completes it again). Then EM_Onboarding_Recalc runs for the task&apos;s study (WhatId = the study, or the Care Program Site&apos;s study), followed by EM_Onboarding_At_Risk_Eval (Recalc only re-evaluates At Risk when it writes the study).</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Reopened</name>
        <dataType>Boolean</dataType>
        <expression>BLANKVALUE(TEXT({!$Record__Prior.Status}), &quot;&quot;) = &quot;Completed&quot; &amp;&amp; BLANKVALUE(TEXT({!$Record.Status}), &quot;&quot;) &lt;&gt; &quot;Completed&quot;</expression>
    </formulas>
    <interviewLabel>EM Onboarding Task Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EM Onboarding Task Sync</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Site</name>
        <label>Is the task on a site?</label>
        <locationX>750</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Site</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CareProgramSite</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>CareProgramId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Exception</name>
        <label>Mark the item as an exception</label>
        <locationX>500</locationX>
        <locationY>240</locationY>
        <connector>
            <targetReference>Get_Site</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>EM_Auto_Completed__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EM_Source__c</field>
            <value>
                <stringValue>Exception</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Reopened</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.EM_Item_Key__c})) &amp;&amp; NOT(ISBLANK({!$Record.WhatId})) &amp;&amp; OR(ISCHANGED({!$Record.Status}), ISCHANGED({!$Record.ActivityDate}), ISCHANGED({!$Record.EM_Is_Required__c})) &amp;&amp; NOT(ISCHANGED({!$Record.EM_Auto_Completed__c})) &amp;&amp; NOT({!$Setup.Migration_Mode__c.Is_Active__c})</filterFormula>
        <object>Task</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>AtRisk_Site</name>
        <label>Re-evaluate At Risk (site&apos;s study)</label>
        <locationX>1250</locationX>
        <locationY>720</locationY>
        <flowName>EM_Onboarding_At_Risk_Eval</flowName>
        <inputAssignments>
            <name>in_CareProgramId</name>
            <value>
                <elementReference>Get_Site.CareProgramId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>AtRisk_Study</name>
        <label>Re-evaluate At Risk (study)</label>
        <locationX>0</locationX>
        <locationY>840</locationY>
        <flowName>EM_Onboarding_At_Risk_Eval</flowName>
        <inputAssignments>
            <name>in_CareProgramId</name>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Recalc_Site</name>
        <label>Recalc the site&apos;s study</label>
        <locationX>1250</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Decision_EvalSite</targetReference>
        </connector>
        <flowName>EM_Onboarding_Recalc</flowName>
        <inputAssignments>
            <name>in_CareProgramId</name>
            <value>
                <elementReference>Get_Site.CareProgramId</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>Recalc_Study</name>
        <label>Recalc the study</label>
        <locationX>0</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Decision_EvalStudy</targetReference>
        </connector>
        <flowName>EM_Onboarding_Recalc</flowName>
        <inputAssignments>
            <name>in_CareProgramId</name>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
</Flow>
