    <description>Missed inbound call on a recruiter&apos;s personal line (call ended while still owned by a queue, or never accepted) creates a high-priority call-back task for that recruiter, linked to the caller&apos;s Lead or Patient, marked as after hours when the call started outside the team&apos;s business hours (EM NY Hours / EM KYTN Hours). Team-line missed calls (default until the client decides): the task goes to the active team member with the fewest open missed-call tasks. Faults never block the call record update.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Description</name>
        <dataType>String</dataType>
        <expression>&quot;Missed inbound call to &quot; &amp; {!Get_Number_Route.Owner_Name__c} &amp; &quot;&apos;s line (&quot; &amp; {!$Record.ToPhoneNumber} &amp; &quot;) from &quot; &amp; {!$Record.FromPhoneNumber} &amp; IF({!varWithinHours}, &quot; during business hours&quot;, &quot; after business hours&quot;) &amp; &quot;. Voice call: &quot; &amp; {!$Record.Name} &amp; &quot;.&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_DialedE164</name>
        <dataType>String</dataType>
        <expression>&quot;+1&quot; &amp; RIGHT(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.ToPhoneNumber}, &quot;+&quot;, &quot;&quot;), &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;), &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;), 10)</expression>
    </formulas>
    <formulas>
        <name>fx_OwnerIsQueue</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!$Record.OwnerId}, 3) = &quot;00G&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_RelatedIsLead</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!$Record.RelatedRecordId}, 3) = &quot;00Q&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_Subject</name>
        <dataType>String</dataType>
        <expression>IF({!varWithinHours}, &quot;Missed call&quot;, &quot;Missed call (after hours)&quot;) &amp; &quot;: call back &quot; &amp; {!$Record.FromPhoneNumber}</expression>
    </formulas>
