    </formulas>
    <formulas>
        <name>fx_MemberName</name>
        <dataType>String</dataType>
        <expression>{!Loop_Members.Name} &amp; &quot;, &quot;</expression>
    </formulas>
    <formulas>
        <name>fx_PI</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!var_PI}) &gt; 2, LEFT(LEFT({!var_PI}, LEN({!var_PI}) - 2), 255), BLANKVALUE({!Get_Study.EM_PI__c}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>fx_SubI</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!var_SubI}) &gt; 2, LEFT(LEFT({!var_SubI}, LEN({!var_SubI}) - 2), 255), BLANKVALUE({!Get_Study.EM_Sub_I__c}, &quot;&quot;))</expression>
