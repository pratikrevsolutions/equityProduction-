<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_NeedsAward</name>
        <label>Still Not Started?</label>
        <locationX>750</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Run_BD_Copy</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already awarded</defaultConnectorLabel>
        <rules>
            <name>Decision_NeedsAward_Needs</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_NeedsAward</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Award</targetReference>
            </connector>
            <label>Yes — mark Study Awarded</label>
        </rules>
    </decisions>
    <description>Phase 4 quick action &quot;Start Onboarding&quot; on a study (TDD §5.5 manual path; F-07 does the same automatically at BD award). Confirms, marks the study Study Awarded (with today as the awarded date) when it is still Not Started, generates the onboarding tasks + regulatory checklist (EM_Onboarding_Items_Generate — never duplicates), recalculates, and reports what was created. Safe to run again after adding sites or team members.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_AwardDate</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!Get_CP.Study_Awarded_Date__c}, {!$Flow.CurrentDate})</expression>
    </formulas>
    <formulas>
        <name>fx_NeedsAward</name>
        <dataType>Boolean</dataType>
        <expression>BLANKVALUE(TEXT({!Get_CP.Onboarding_Status__c}), &quot;Not Started&quot;) = &quot;Not Started&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_StatusText</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(TEXT({!Get_CP.Onboarding_Status__c}), &quot;Not Started&quot;)</expression>
    </formulas>
    <interviewLabel>EM Start Onboarding {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EM Start Onboarding</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_CP</name>
        <label>Get the study</label>
        <locationX>250</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CareProgram</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Onboarding_Status__c</queriedFields>
        <queriedFields>Study_Awarded_Date__c</queriedFields>
        <queriedFields>Onboarding_Progress__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Award</name>
        <label>Study Awarded + awarded date</label>
        <locationX>1000</locationX>
        <locationY>480</locationY>
        <connector>
            <targetReference>Run_BD_Copy</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Onboarding_Status__c</field>
            <value>
                <stringValue>Study Awarded</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Study_Awarded_Date__c</field>
            <value>
                <elementReference>fx_AwardDate</elementReference>
            </value>
        </inputAssignments>
        <object>CareProgram</object>
    </recordUpdates>
    <screens>
        <name>Screen_Confirm</name>
        <label>Start onboarding</label>
        <locationX>500</locationX>
        <locationY>240</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_NeedsAward</targetReference>
        </connector>
        <fields>
            <name>Txt_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!Get_CP.Name}&lt;/b&gt; — current onboarding status: &lt;b&gt;{!fx_StatusText}&lt;/b&gt;.&lt;/p&gt;&lt;p&gt;Next creates the onboarding tasks for every workstream (Contract &amp;amp; Budget, Regulatory &amp;amp; SSU, IRB, Site Readiness, CRIO &amp;amp; eSource, Recruitment Readiness, Greenlight &amp;amp; Activation) and the regulatory document checklist for each Care Program Site. Items that already exist are never duplicated, so you can run this again after adding sites or team members.&lt;/p&gt;&lt;p&gt;If the study is still &lt;i&gt;Not Started&lt;/i&gt; it moves to &lt;b&gt;Study Awarded&lt;/b&gt; with today as the awarded date.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Done</name>
        <label>Onboarding started</label>
        <locationX>0</locationX>
        <locationY>720</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Txt_Done</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!var_TasksCreated}&lt;/b&gt; onboarding task(s) and &lt;b&gt;{!var_ChecklistCreated}&lt;/b&gt; regulatory checklist item(s) created.&lt;/p&gt;&lt;p&gt;Onboarding status: &lt;b&gt;{!var_Status}&lt;/b&gt; · progress &lt;b&gt;{!var_Progress}%&lt;/b&gt;. Work the tasks from the Onboarding tab — the study advances automatically as each workstream&apos;s evidence lands.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Error</name>
        <label>Could not start onboarding</label>
        <locationX>250</locationX>
        <locationY>840</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Txt_Error</name>
            <fieldText>&lt;p&gt;Something went wrong: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CP</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <subflows>
        <name>Run_BD_Copy</name>
        <label>Copy the BD overlap (WU10-15f)</label>
        <locationX>750</locationX>
        <locationY>560</locationY>
        <connector>
            <targetReference>Run_Generate</targetReference>
        </connector>
        <flowName>EM_BD_Copy</flowName>
        <inputAssignments>
            <name>in_CareProgramId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>in_Overwrite</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Run_Generate</name>
        <label>Generate items + recalc</label>
        <locationX>1250</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Screen_Done</targetReference>
        </connector>
        <flowName>EM_Onboarding_Items_Generate</flowName>
        <inputAssignments>
            <name>in_CareProgramId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>var_TasksCreated</assignToReference>
            <name>out_TasksCreated</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>var_ChecklistCreated</assignToReference>
            <name>out_ChecklistCreated</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>var_Status</assignToReference>
            <name>out_Status</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>var_Progress</assignToReference>
            <name>out_Progress</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_ChecklistCreated</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>var_Progress</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>var_Status</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_TasksCreated</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
