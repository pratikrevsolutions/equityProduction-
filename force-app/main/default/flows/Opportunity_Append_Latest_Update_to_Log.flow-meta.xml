<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_Log_Field</name>
        <label>Update Log Field</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Update_Log__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>tt_Combined_Log</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.NextStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_Formatted_Update</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>f_Formatted_Update</name>
        <dataType>String</dataType>
        <expression>TEXT(MONTH(TODAY())) &amp; &quot;/&quot; &amp; TEXT(DAY(TODAY())) &amp; &quot;/&quot; &amp; TEXT(YEAR(TODAY())) &amp; &quot; - &quot; &amp; {!$Record.NextStep}</expression>
    </formulas>
    <formulas>
        <name>f_Prior_Formatted_Update</name>
        <dataType>String</dataType>
        <expression>{!$Record__Prior.NextStep}</expression>
    </formulas>
    <interviewLabel>Opportunity - Append Latest Update to Log {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Append Latest Update to Log</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Log_Field</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>NextStep</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NextStep</field>
            <operator>NotEqualTo</operator>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>tt_Combined_Log</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!f_Prior_Formatted_Update}
{!$Record__Prior.Update_Log__c}</text>
    </textTemplates>
</Flow>
