    <textTemplates>
        <name>tt_EmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi Team,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Great news! We have officially been awarded a new study. To ensure a seamless and efficient startup timeline, please review the study details and complete your respective action items below.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;u&gt;Study Details&lt;/u&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Protocol Number: {!Get_Opportunity_Info.Protocol_Number__c}&lt;/li&gt;&lt;li&gt;Sponsor: {!Get_Opportunity_Info.Account.Name}&lt;/li&gt;&lt;li&gt;Therapeutic Area &amp;amp; Indication: {!Get_Opportunity_Info.Therapeutic_Area__c} - {!Get_Opportunity_Info.Indication__c}&lt;/li&gt;&lt;li&gt;Study Title: {!Get_Opportunity_Info.Description}&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;u&gt;Site Details&lt;/u&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Principal Investigator: {!Get_Opportunity_Info.Assigned_PI__c}&lt;/li&gt;&lt;li&gt;Site: {!Get_Opportunity_Info.Site__c}&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;u&gt;Immediate Action Items&lt;/u&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Regulatory Team&lt;ul&gt;&lt;li&gt;Begin compiling the eTMF/Regulatory Binder once sent.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;Clinical Site Team&lt;ul&gt;&lt;li&gt;Access and review the protocol and the Investigator&apos;s Brochure.&lt;/li&gt;&lt;li&gt;Schedule and prepare for the upcoming SIV.&lt;/li&gt;&lt;li&gt;Assign a Clinical Research Coordinator to this trial.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;Contracts &amp;amp; Budgets&lt;ul&gt;&lt;li&gt;Prepare for the CTA and Budget negotiation.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;Inside Sales Associate&lt;ul&gt;&lt;li&gt;Add this study to the PI&apos;s CV and update it in CRIO.&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;I have attached the protocol and all other received documents here.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you all for your hard work in securing this study. Let&apos;s work together to make this a highly successful launch!&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Best,&lt;/p&gt;&lt;p&gt;Grace&lt;/p&gt;</text>
    </textTemplates>
